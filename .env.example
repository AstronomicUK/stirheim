# Copy to .env.local (gitignored) and fill in. Vite exposes only VITE_-prefixed variables.
#
# Local stack: run `supabase start` (or `supabase status`) and paste the "API URL" and the
# anon / publishable key it prints. Hosted: Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
