{
  "name": "stirheim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "db:start": "DOCKER_HOST=unix://$HOME/.docker/run/docker.sock supabase start",
    "db:stop": "DOCKER_HOST=unix://$HOME/.docker/run/docker.sock supabase stop",
    "db:reset": "DOCKER_HOST=unix://$HOME/.docker/run/docker.sock supabase db reset",
    "db:status": "DOCKER_HOST=unix://$HOME/.docker/run/docker.sock supabase status",
    "db:types": "DOCKER_HOST=unix://$HOME/.docker/run/docker.sock supabase gen types typescript --local --schema public > src/api/database.types.ts",
    "test:integration": "SUPABASE_LOCAL=1 vitest run --no-file-parallelism src/api/__tests__",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "dev:preview": "vite --port ${PORT:-5173} --strictPort"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.102.8",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
